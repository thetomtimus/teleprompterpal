---
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowDown from '@phosphor-icons/core/assets/regular/arrow-down.svg?raw';
import play from '@phosphor-icons/core/assets/regular/play.svg?raw';
import pause from '@phosphor-icons/core/assets/regular/pause.svg?raw';
import restart from '@phosphor-icons/core/assets/regular/arrow-counter-clockwise.svg?raw';
import text from '@phosphor-icons/core/assets/regular/text-align-left.svg?raw';
import sliders from '@phosphor-icons/core/assets/regular/sliders-horizontal.svg?raw';
import crop from '@phosphor-icons/core/assets/regular/crop.svg?raw';
import share from '@phosphor-icons/core/assets/regular/export.svg?raw';
import camera from '@phosphor-icons/core/assets/regular/video-camera.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import x from '@phosphor-icons/core/assets/regular/x.svg?raw';
import minus from '@phosphor-icons/core/assets/regular/minus.svg?raw';
import lock from '@phosphor-icons/core/assets/regular/lock-simple.svg?raw';
import caret from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import globe from '@phosphor-icons/core/assets/regular/globe.svg?raw';
import menu from '@phosphor-icons/core/assets/regular/list.svg?raw';
import iphone from '@phosphor-icons/core/assets/regular/device-mobile.svg?raw';
import scissors from '@phosphor-icons/core/assets/regular/scissors.svg?raw';
const icons = { arrowRight, arrowDown, play, pause, restart, text, sliders, crop, share, camera, check, x, minus, lock, caret, globe, menu, iphone, scissors };
interface Props { name: keyof typeof icons; size?: number; class?: string; }
const { name, size = 20, class: className = '' } = Astro.props;
---
<span class:list={['icon', className]} style={`--icon-size:${size}px`} aria-hidden="true" set:html={icons[name]} />
