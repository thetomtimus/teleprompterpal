---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import ArticleSummarizers from '../../components/ArticleSummarizers.astro';
import { site } from '../../data/site';
import '../../styles/guides.css';

export async function getStaticPaths() {
  const privatePreview = process.env.VERCEL_ENV === 'preview' && process.env.PAL_PRIVATE_ARTICLE_PREVIEW === '1';
  const guides = await getCollection('guides', ({ data }) => !data.draft || privatePreview);
  return guides.map(guide => ({ params: { id: guide.id }, props: { guide } }));
}
interface Props { guide: CollectionEntry<'guides'>; }
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const published = guide.data.date.toISOString();
const formatDate = (date: Date) => new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
const modified = guide.data.updated?.toISOString();
const showUpdated = guide.data.updated && guide.data.updated.toISOString().slice(0, 10) !== published.slice(0, 10);
const readingText = [guide.data.intro ?? '', ...guide.data.takeaways, guide.body ?? ''].join(' ')
  .replace(/<[^>]*>/g, ' ').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const minutes = Math.max(1, Math.ceil(readingText.trim().split(/\s+/).length / 200));
const canonical = `https://teleprompterpal.com/guides/${guide.id}/`;
const sections = guide.data.contents ? headings.filter(heading => heading.depth === 2) : [];
const available = await getCollection('guides', ({ data }) => !data.draft);
const explicitRelated = guide.data.relatedGuides.map(id => {
  const entry = available.find(item => item.id === id && item.id !== guide.id);
  if (!entry) throw new Error(`Related guide must be another published guide: ${guide.id} → ${id}`);
  return entry;
});
const related = explicitRelated.length ? explicitRelated : available
  .filter(item => item.id !== guide.id && item.data.topics.some(topic => guide.data.topics.includes(topic)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const shareImage = guide.data.shareImage;
const coverImage = guide.data.coverImage;
const articleImage = coverImage ?? shareImage;
const authorInitials = guide.data.author.name.split(/\s+/).map(part => part[0]).slice(0, 2).join('');
---
<Layout title={guide.data.title} description={guide.data.description} type="article" published={published} modified={modified} image={shareImage?.src} imageAlt={shareImage?.alt} imageWidth={shareImage?.width} imageHeight={shareImage?.height}>
  <SiteHeader />
  <main id="main" class="guides-main guide-page">
    <article class="guide-article" itemscope itemtype="https://schema.org/Article">
      <link itemprop="mainEntityOfPage" href={canonical} />
      {articleImage && <link itemprop="image" href={`https://teleprompterpal.com${articleImage.src}`} />}
      <meta itemprop="description" content={guide.data.description} />
      <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="Teleprompter Pal" /><link itemprop="url" href="https://teleprompterpal.com/" /></div>
      {modified && <meta itemprop="dateModified" content={modified} />}
      <header class="guide-hero">
        {coverImage && <picture class="guide-hero-art" aria-hidden="true">
          {coverImage.mobileSrc && <source media="(max-width: 639px)" srcset={coverImage.mobileSrc} type="image/webp" />}
          <img src={coverImage.src} srcset={coverImage.sources.length ? coverImage.sources.map(source => `${source.src} ${source.width}w`).join(', ') : undefined} sizes="100vw" width={coverImage.width} height={coverImage.height} alt={coverImage.alt} loading="eager" decoding="async" fetchpriority="high" />
        </picture>}
        <div class="guide-shell guide-hero-shell">
          <div class="guide-heading">
            <nav class="guide-breadcrumbs" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
      <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a itemprop="item" href="/"><span itemprop="name">Home</span></a><meta itemprop="position" content="1" /></span>
      <span aria-hidden="true">/</span>
      <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a itemprop="item" href="/guides/"><span itemprop="name">Guides</span></a><meta itemprop="position" content="2" /></span>
      <span aria-hidden="true">/</span><span aria-current="page">{guide.data.breadcrumb ?? guide.data.title}</span>
    </nav>
            <h1 itemprop="headline">{guide.data.headline}</h1>
            <p class="guide-description">{guide.data.description}</p>
            <div class="guide-byline">
              <span class="guide-author-avatar" aria-hidden="true">{authorInitials}</span>
              <div class="guide-byline-copy">
                <span class="guide-author-name">By <a itemprop="author" itemscope itemtype="https://schema.org/Organization" href={guide.data.author.url}><span itemprop="name">{guide.data.author.name}</span><link itemprop="url" href={guide.data.author.url} /></a></span>
                <div class="guide-date-line">
                  <span><time itemprop="datePublished" datetime={published}>{formatDate(guide.data.date)}</time></span>
                  {showUpdated && <span>Updated <time datetime={modified}>{formatDate(guide.data.updated!)}</time></span>}
                  <span>{minutes} min read</span>
                </div>
              </div>
            </div>
            <ArticleSummarizers canonical={canonical} available={!guide.data.draft} />
          </div>
          <hr class="guide-heading-divider" />
        </div>
      </header>
      <div class="guide-shell guide-body-shell">
      <div class="guide-reading-layout">
      <div class="guide-reading-column">
      <div itemprop="articleBody">
        {guide.data.intro && <p class="guide-opening">{guide.data.intro}</p>}
        {guide.data.takeaways.length > 0 && <section class="guide-takeaways" aria-labelledby="takeaways-heading"><h2 id="takeaways-heading">The short answer</h2><ul>{guide.data.takeaways.map(takeaway => <li>{takeaway}</li>)}</ul></section>}
        {sections.length >= 3 && <nav class="guide-contents-mobile" aria-label="Article sections"><details><summary>On this page <Icon name="caret" size={18} /></summary><ul>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ul></details></nav>}
        <div class="guide-prose"><Content /></div>
      </div>
      {(related.length > 0 || guide.data.relatedResources.length > 0) && <section class="guide-related" aria-labelledby="related-heading"><h2 id="related-heading">For your next recording</h2><ul>
        {related.map(item => <li><a href={`/guides/${item.id}/`}>{item.data.title}</a><p>{item.data.description}</p></li>)}
        {guide.data.relatedResources.map(item => <li><a href={item.href}>{item.title}</a><p>{item.description}</p></li>)}
      </ul></section>}
      <p class="guide-editorial">Published by the Teleprompter Pal team. Read <a href="/about/#editorial">how our guides are prepared and checked</a>, including illustration and testing limits. <a href="/about/#corrections">Send a correction</a>.</p>
      <nav class="guide-end" aria-label="More guides"><a href="/guides/">Back to all guides</a></nav>
      </div>
      <aside class="guide-sidebar" aria-label="Guide navigation and early access">
        <div class="guide-sidebar-inner">
          {sections.length >= 3 && <nav class="guide-contents" aria-labelledby="contents-heading"><h2 id="contents-heading">On this page</h2><ul>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ul></nav>}
          <section class="guide-sidebar-cta" aria-labelledby="sidebar-cta-heading">
            <h2 id="sidebar-cta-heading">Recording on iPhone?</h2>
            <p>Keep your script, recording and retakes together in Teleprompter Pal.</p>
            <a href={`/${site.accessUrl}`}>Request early access <Icon name="arrowRight" size={18} /></a>
            <p class="guide-sidebar-note">Private beta. Manual scrolling today.</p>
          </section>
        </div>
      </aside>
      </div>
      </div>
    </article>
  </main>
  <SiteFooter />
</Layout>
