const rows: { feature: string; note: string; pal: Status; competitor: Status }[] = [
  { feature: 'Use more than 750 characters for free', note: 'Script text, not a recording-duration limit', pal: { state: 'yes', detail: 'Within the 1 MB text safeguard' }, competitor: { state: 'no', detail: 'Longer scripts require the one-time upgrade' } },
  { feature: 'Set the scrolling pace', note: 'Choose a manual speed for reading', pal: { state: 'yes', detail: 'Free reader' }, competitor: { state: 'yes', detail: 'Speed control documented' } },
  { feature: 'Read while recording inside the app', note: 'A built-in camera differs from a reader beside another camera', pal: { state: 'yes', detail: 'Free iPhone recording' }, competitor: { state: 'unknown', detail: 'Rig guide says no video; capture flow unverified' } },
  { feature: 'Trim and crop the recorded take', note: 'Video editing, separate from editing script text', pal: { state: 'yes', detail: 'Free saved video edits' }, competitor: { state: 'unknown', detail: 'Recorded-video editing unverified' } },
  { feature: 'Reopen edits and restore the original', note: 'Recover full length and framing after saving an edit', pal: { state: 'yes', detail: 'Saved internal device check' }, competitor: { state: 'unknown', detail: 'Exact reset task untested' } },
  { feature: 'Export and deliver an MP4', note: 'Video delivery, separate from sharing a script', pal: { state: 'yes', detail: 'Pro; every delivery requires Pro' }, competitor: { state: 'unknown', detail: 'In-app video delivery unverified' } },
  { feature: 'Follow speech with voice recognition', note: 'Different from a pace you set manually', pal: { state: 'no', detail: 'Set-speed reader in reviewed implementation' }, competitor: { state: 'yes', detail: 'Voice scrolling documented; not benchmarked' } },
  { feature: 'Mirror text for a physical rig', note: 'Text reflection, not a mirrored selfie-camera preview', pal: { state: 'unknown', detail: 'Mirror-rig task untested' }, competitor: { state: 'yes', detail: 'Horizontal and vertical mirroring documented' } },
  { feature: 'Import Word and PDF scripts', note: 'Teleprompter Pal currently imports plain text', pal: { state: 'no' }, competitor: { state: 'yes', detail: 'iOS imports documented' } },
  { feature: 'Keyboard and presentation-remote controls', note: 'Control script scrolling from supported hardware', pal: { state: 'no', detail: 'Not in reviewed reader implementation' }, competitor: { state: 'yes', detail: 'Supported controls documented; untested' } },
  { feature: 'Use a local mode without logging in', note: 'Cloud sharing and online services have separate requirements', pal: { state: 'yes', detail: 'Local scripts and takes' }, competitor: { state: 'yes', detail: 'Skip-login mode documented' } },
  { feature: 'Released for iPhone', note: 'Availability is separate from device testing', pal: { state: 'yes', detail: 'iOS 18+' }, competitor: { state: 'yes', detail: 'Current listing: iOS 14+' } },
