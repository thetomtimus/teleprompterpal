---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AccessButton from '../../components/AccessButton.astro';
import '../../styles/compare.css';
const comparisons = [
  { href: '/compare/bigvu-alternative/', icon: '/images/compare/bigvu-app-icon.jpg', title: 'Teleprompter Pal vs BIGVU', category: 'AI and publishing suite', summary: 'Choose Teleprompter Pal for focused iPhone recording, saved edits and a lower annual Pro price. Compare that workflow with BIGVU’s broader production tools.' },
  { href: '/compare/promptsmart-pro-alternative/', icon: '/images/compare/promptsmart-pro-app-icon.jpg', title: 'Teleprompter Pal vs PromptSmart Pro', category: 'Voice-following teleprompter', summary: 'Record and edit for free with Teleprompter Pal, or consider PromptSmart Pro for VoiceTrack. Compare prompting, retakes, exports and the actual costs.' },
];
---
<Layout title="Teleprompter Pal vs Competitors | iPhone Teleprompter Comparisons" description="Compare Teleprompter Pal with BIGVU and PromptSmart Pro. See features, free recording, editing, export costs and the workflow each app suits.">
  <SiteHeader />
  <main id="main" class="container compare-main compare-hub">
    <header class="compare-hub-intro">
      <h1>Teleprompter Pal<br />vs the rest.</h1>
      <p>Keep your script, recording and retakes together on iPhone. Teleprompter Pal lets you record and edit for free, then upgrade when you need an MP4. Compare a specific app below, or start with our <a href="/guides/best-teleprompter-apps-for-iphone/">best teleprompter apps for iPhone</a>.</p>
    </header>
    <div class="compare-card-grid" aria-label="Teleprompter Pal comparisons">
      {comparisons.map(item => <a class="compare-app-card" href={item.href}>
        <img src={item.icon} width="56" height="56" alt="" />
        <div><h2>{item.title}</h2><p class="compare-card-category">{item.category}</p><p class="compare-card-summary">{item.summary}</p></div>
      </a>)}
    </div>
    <section class="compare-hub-close" aria-labelledby="compare-close-title">
      <h2 id="compare-close-title">Record. Refine. Keep the original.</h2>
      <p>Start with free recording and editing in Teleprompter Pal. Pro adds MP4 export and delivery to Photos, Files or Share.</p>
      <AccessButton />
      <p class="compare-hub-method">We make Teleprompter Pal. Each comparison separates our internal checks from competitors’ documented features and shows where another app may fit better.</p>
    </section>
  </main>
  <SiteFooter />
</Layout>
