---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/tools.css';
import '../../styles/compare.css';
import '../../styles/tool-cards.css';
const tools = [
  { href: '/tools/speech-time-calculator/', icon: 'timer' as const, title: 'Speech time calculator', category: 'Timing and rehearsal', summary: 'Estimate speaking time, measure your pace and find a word count for your time limit.', action: 'Time your script' },
  { href: '/tools/script-cleaner/', icon: 'broom' as const, title: 'Script cleaner', category: 'Script preparation', summary: 'Remove unwanted line breaks and extra spaces. Keep paragraphs or create shorter reading chunks.', action: 'Clean your script' },
  { href: '/tools/subtitle-to-script/', icon: 'subtitles' as const, title: 'Subtitle to script', category: 'SRT and VTT to text', summary: 'Turn subtitle files into editable text. Remove timecodes, then copy or download your script.', action: 'Convert your subtitles' },
];
---
<Layout title="Free Script & Speaking Tools | Teleprompter Pal" description="Prepare your next talking video with free tools from Teleprompter Pal. Clean a script, convert subtitles to text and estimate speaking time. No signup.">
  <SiteHeader />
  <main id="main" class="tools-main tools-index container">
    <nav class="tool-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Tools</span></nav>
    <header class="tool-intro"><h1>A little prep.<br />A better take.</h1><p>Free tools to help you plan your words before you press record.</p></header>
    <div class="compare-card-grid" aria-label="Free script and speaking tools">
      {tools.map(tool => <a class="compare-app-card tool-card" href={tool.href}>
        <span class="tool-card-symbol"><Icon name={tool.icon} size={28} /></span>
        <div class="tool-card-copy"><h2>{tool.title}</h2><p class="compare-card-category">{tool.category}</p><p class="compare-card-summary">{tool.summary}</p><span class="tool-card-action">{tool.action}<Icon name="arrowRight" size={18} /></span></div>
      </a>)}
    </div>
    <p class="tool-directory-privacy"><Icon name="lock" size={16} />Free, with no signup. Your scripts stay in your browser.</p>
    <div class="tool-directory-note"><h2>Ready to rehearse?</h2><p>Use our <a href="https://freeteleprompteronline.com/#script">free online teleprompter</a> for scrolling text in your browser, or <a href="/guides/browser-teleprompter-vs-iphone-app/">compare browser and iPhone setups</a> before recording.</p></div>
  </main>
  <SiteFooter />
</Layout>
