      "name": "Primary Access Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The large early-access action; its violet background, light edges, and minimum height are the canonical pill treatment.",
      "html": "<a class=\"ds-primary\" href=\"mailto:contact@teleprompterpal.com?subject=Teleprompter%20Pal%20beta%20access\">Get early access<svg width=\"20\" height=\"20\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;border:0;border-radius:var(--radius-control,80px);font-family:var(--font-sans,Figtree,sans-serif);font-weight:700;white-space:nowrap;text-decoration:none;color:var(--color-text,#fff);cursor:pointer;transition:filter .2s,transform .2s var(--ease-out,cubic-bezier(.16,1,.3,1)),box-shadow .2s;min-height:68px;padding:21px 32px 22px;font-size:24px;line-height:24px;background:var(--gradient-primary,linear-gradient(90deg,#8f67ff 0%,#6136d9 100%));box-shadow:var(--shadow-primary,0 10px 20px rgba(0,0,0,.1),inset -3px -3px 2px -4px rgba(255,255,255,.89),inset 3px 2px 2px -3px #fff)}.ds-primary:hover{filter:brightness(1.13);transform:translateY(-2px)}.ds-primary:active{transform:translateY(1px) scale(.98)}.ds-primary:focus-visible{outline:3px solid var(--color-lavender,#c3aaff);outline-offset:6px}.ds-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:hover,.ds-primary:active{transform:none}}"
    },
