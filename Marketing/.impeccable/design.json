      "css": ".ds-compact{display:inline-flex;align-items:center;justify-content:center;gap:12px;border:0;border-radius:var(--radius-control,80px);font-family:var(--font-sans,Figtree,sans-serif);font-weight:700;white-space:nowrap;text-decoration:none;color:var(--color-text,#fff);cursor:pointer;transition:filter .2s,transform .2s var(--ease-out,cubic-bezier(.16,1,.3,1)),box-shadow .2s;min-height:40px;padding:12px 16px;font-size:16px;line-height:16px;gap:8px;background:linear-gradient(90deg,rgba(68,49,235,.06),rgba(143,102,255,.1));box-shadow:0 10px 20px rgba(0,0,0,.17),inset -3px -2px 1px -3px rgba(255,255,255,.89),inset 3px 2px 1px -3px rgba(255,255,255,.77)}.ds-compact:hover{filter:brightness(1.13);transform:translateY(-2px)}.ds-compact:active{transform:translateY(1px) scale(.98)}.ds-compact:focus-visible{outline:3px solid var(--color-lavender,#c3aaff);outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-compact{transition:none}.ds-compact:hover,.ds-compact:active{transform:none}}"
